{
  "expo": {
    "name": "fin-pet",
    "slug": "fin-pet",
    "version": "1.0.0",
    "scheme": "fin-pet",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static",
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/fin-pet"
    },
    "sourceDir": "src"
  }
}
